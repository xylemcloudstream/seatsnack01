# --- Set these in Cloudflare Pages > Settings > Environment variables ---
# (and copy the VITE_ one into a local .env file for `npm run dev`)

# NeonDB connection string (Neon dashboard > Connection Details > "Pooled connection")
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/theatre_food_kit?sslmode=require

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" (type: Web application). Add your Pages domain
# (and http://localhost:5173 for local dev) under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Secret used to sign our own short-lived session tokens after verifying Google.
# Generate one with: openssl rand -base64 32
APP_JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list — only these Google accounts can reach /superadmin
SUPERADMIN_EMAILS=sreehariar2008@gmail.com,lofiscide@gmail.com

# Razorpay TEST/demo keys — https://dashboard.razorpay.com/app/keys (toggle "Test Mode")
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Optional but recommended — Settings > Webhooks > create one pointed at
# https://<your-pages-domain>/api/webhooks/razorpay, subscribed to payment.captured
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
